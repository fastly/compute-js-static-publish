{
  "compilerOptions": {
    "target": "es2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "lib": ["es2022"],
    "esModuleInterop": true,
    "isolatedModules": true,
    "erasableSyntaxOnly": true,
    "allowJs": true,
    "noEmit": true,
    "customConditions": ["fastly"],
    "types": ["@fastly/js-compute"]
  },
  "include": ["src", "static-publish.rc.js"]
}
