{
  "name": "my-site",
  "version": "0.1.0",
  "description": "My site",
  "author": "me@example.com",
  "type": "module",
  "devDependencies": {
    "@fastly/cli": "^16.0.0",
    "@fastly/compute-js-static-publish": "<compute-js-static-publish>"
  },
  "dependencies": {
    "@fastly/js-compute": "^4.0.0"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "private": true,
  "scripts": {
    "dev:start": "fastly compute serve",
    "fastly:deploy": "fastly compute publish",
    "build": "js-compute-runtime ./src/index.js ./bin/main.wasm",
    "prebuild": "compute-js-static-publish run-template-hook prebuild",
    "postbuild": "compute-js-static-publish run-template-hook postbuild",
    "postinstall": "compute-js-static-publish run-template-hook postinstall",
    "dev:publish": "npx @fastly/compute-js-static-publish publish-content --local",
    "fastly:publish": "npx @fastly/compute-js-static-publish publish-content"
  }
}