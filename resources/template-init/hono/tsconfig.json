{
  "compilerOptions": {
    "target": "es2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "lib": ["es2022"],
    "esModuleInterop": true,
    "isolatedModules": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "customConditions": ["fastly"],
    "types": ["@fastly/js-compute"]
  },
  "include": ["**/*.ts", "**/*.mts"],
  "exclude": ["node_modules"]
}
