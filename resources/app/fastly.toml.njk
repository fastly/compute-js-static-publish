# This file describes a Fastly Compute package. To learn more visit:
# https://developer.fastly.com/reference/fastly-toml/

authors = [ {{ author | toml }} ]
description = {{ description | toml }}
language = "javascript"
manifest_version = 3
name = {{ name | toml }}
{% if serviceId %}
service_id = {{ serviceId | toml }}
{% endif %}

[scripts]
build = "npm run build"

{% if storage.mode == 'kv-store' %}
[local_server]

[local_server.kv_stores]
{{ storage.kvStoreName | tomlKey }} = { file = {{ localServerKvStorePath | toml }}, format = "json" }

[setup]

[setup.kv_stores]
[setup.kv_stores.{{ storage.kvStoreName | tomlKey }}]
{% elif storage.mode == 's3' %}
[local_server]

[local_server.secret_stores]
[[local_server.secret_stores.S3_CREDENTIALS]]
key = "S3_ACCESS_KEY_ID"
env = "S3_ACCESS_KEY_ID"
[[local_server.secret_stores.S3_CREDENTIALS]]
key = "S3_SECRET_ACCESS_KEY"
env = "S3_SECRET_ACCESS_KEY"

[local_server.backends]
[local_server.backends.s3_storage]
url = {{ s3EndpointUrl | toml }}
override_host = {{ s3EndpointHostname | toml }}

[setup]

[setup.backends]
[setup.backends.s3_storage]
address = {{ s3EndpointHostname | toml }}
description = "S3 API endpoint"
port = 443
[setup.secret_stores]
[setup.secret_stores.S3_CREDENTIALS]
description = "Credentials for S3 storage"
[setup.secret_stores.S3_CREDENTIALS.entries]
[setup.secret_stores.S3_CREDENTIALS.entries.S3_ACCESS_KEY_ID]
description = "Access Key ID"
[setup.secret_stores.S3_CREDENTIALS.entries.S3_SECRET_ACCESS_KEY]
description = "Secret Access Key"
{% endif %}

